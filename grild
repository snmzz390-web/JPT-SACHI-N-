<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Football World Shop</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#f5f5f5;
}

header{
background:#0d3b2e;
color:white;
padding:20px 10%;
display:flex;
justify-content:space-between;
align-items:center;
}

header h1{
font-size:30px;
}

nav a{
color:white;
text-decoration:none;
margin-left:25px;
font-weight:bold;
}

.hero{
height:70vh;
background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
url("https://images.unsplash.com/photo-1508098682722-e99c643e7485?auto=format&fit=crop&w=1600&q=80");
background-size:cover;
background-position:center;
display:flex;
align-items:center;
justify-content:center;
color:white;
text-align:center;
}

.hero h2{
font-size:55px;
margin-bottom:20px;
}

.hero p{
font-size:22px;
margin-bottom:25px;
}

.hero button{
padding:15px 35px;
border:none;
background:#00c853;
color:white;
font-size:18px;
cursor:pointer;
border-radius:5px;
}

.products{
padding:60px 10%;
}

.products h2{
text-align:center;
margin-bottom:40px;
font-size:38px;
color:#0d3b2e;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
}

.card{
background:white;
border-radius:10px;
overflow:hidden;
box-shadow:0 5px 15px rgba(0,0,0,.1);
transition:.3s;
}

.card:hover{
transform:translateY(-10px);
}

.card img{
width:100%;
height:250px;
object-fit:cover;
}

.card-content{
padding:20px;
}

.card h3{
margin-bottom:10px;
}

.price{
font-size:22px;
font-weight:bold;
color:#0d3b2e;
margin:10px 0;
}

.rating{
color:orange;
margin-bottom:15px;
}

button.buy{
width:100%;
padding:12px;
border:none;
background:#0d3b2e;
color:white;
font-size:17px;
cursor:pointer;
}

footer{
background:#0d3b2e;
color:white;
text-align:center;
padding:30px;
margin-top:50px;
}

.cart{
position:fixed;
top:20px;
right:20px;
background:#00c853;
color:white;
padding:15px;
border-radius:50%;
font-size:22px;
cursor:pointer;
}

@media(max-width:768px){
.hero h2{
font-size:36px;
}
.hero p{
font-size:18px;
}
}
</style>
</head>
<body>

<div class="cart">
🛒 <span id="count">0</span>
</div>

<header>
<h1>⚽ Football World</h1>

<nav>
<a href="#">Home</a>
<a href="#">Shop</a>
<a href="#">Accessories</a>
<a href="#">Contact</a>
</nav>

</header>

<section class="hero">

<div>
<h2>Play Like a Champion</h2>
<p>Premium Football Jerseys, Boots & Accessories</p>

<button>Shop Now</button>

</div>

</section>

<section class="products">

<h2>Featured Products</h2>

<div class="grid">

<div class="card">
<img src="https://images.unsplash.com/photo-1517466787929-bc90951d0974?auto=format&fit=crop&w=800&q=80">

<div class="card-content">
<h3>Football</h3>

<div class="price">$39</div>

<div class="rating">★★★★★</div>

<button class="buy">Add to Cart</button>

</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=800&q=80">

<div class="card-content">
<h3>Football Boots</h3>

<div class="price">$129</div>

<div class="rating">★★★★★</div>

<button class="buy">Add to Cart</button>

</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1517927033932-b3d18e61fb3a?auto=format&fit=crop&w=800&q=80">

<div class="card-content">
<h3>Team Jersey</h3>

<div class="price">$79</div>

<div class="rating">★★★★☆</div>

<button class="buy">Add to Cart</button>

</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1518600506278-4e8ef466b810?auto=format&fit=crop&w=800&q=80">

<div class="card-content">
<h3>Goalkeeper Gloves</h3>

<div class="price">$59</div>

<div class="rating">★★★★★</div>

<button class="buy">Add to Cart</button>

</div>
</div>

</div>

</section>

<footer>

<h2>Football World Shop</h2>

<p>Your One-Stop Football Store</p>

<p>© 2026 Football World</p>

</footer>

<script>

let count=0;

document.querySelectorAll(".buy").forEach(btn=>{

btn.addEventListener("click",()=>{

count++;

document.getElementById("count").textContent=count;

alert("Item added to cart!");

});

});

</script>

</body>
</html>